# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Sanity CMS Configuration
VITE_SANITY_PROJECT_ID=your_sanity_project_id_here
VITE_SANITY_DATASET=production
# Optional — only if dataset is private. Invalid tokens break all CMS requests.
# VITE_SANITY_TOKEN=your_sanity_read_token_here

# Editor token — only for npm run seed:sanity (one-time content import)
# SANITY_WRITE_TOKEN=your_sanity_editor_token_here
